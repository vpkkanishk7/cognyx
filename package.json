{
  "name": "cognyx",
  "version": "2.4.0",
  "description": "COGNYX — Precision Digital Phenotyping & Cognitive Assessment Engine",
  "main": "backend/server.js",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start": "node backend/server.js",
    "start:render": "concurrently -k \"node backend/server.js\" \"cd ml_service && uvicorn main:app --host 0.0.0.0 --port 8000\"",
    "dev": "concurrently -k -n \"BACKEND,ML_SVC\" -c \"cyan,magenta\" \"node backend/server.js\" \"cd ml_service && py -3.13 -m uvicorn main:app --port 8000 --reload\"",
    "backend": "node backend/server.js",
    "ml": "cd ml_service && py -3.13 -m uvicorn main:app --port 8000 --reload",
    "train:ml": "py -3.13 ml_service/train_model.py",
    "install:backend": "cd backend && npm install",
    "install:ml": "py -3.13 -m pip install -r ml_service/requirements.txt",
    "install:all": "npm install && cd backend && npm install && cd .. && py -3.13 -m pip install -r ml_service/requirements.txt",
    "test": "cd backend && node test_auth.js",
    "test:ml": "cd backend && node test_ml.js"
  },
  "keywords": [
    "cognitive-assessment",
    "digital-phenotyping",
    "machine-learning",
    "biomarkers",
    "fastapi",
    "express"
  ],
  "author": "COGNYX Health Sciences",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "groq-sdk": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

